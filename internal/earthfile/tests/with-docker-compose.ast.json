{
  "baseRecipe": [
    {
      "command": {
        "args": [
          "DIND_IMAGE",
          "=",
          "earthbuild/dind:alpine-3.24-docker-29.8.2-r0"
        ],
        "name": "ARG"
      }
    },
    {
      "command": {
        "args": [
          "$DIND_IMAGE"
        ],
        "name": "FROM"
      }
    },
    {
      "command": {
        "args": [
          "/test"
        ],
        "name": "WORKDIR"
      }
    }
  ],
  "targets": [
    {
      "name": "all",
      "recipe": [
        {
          "command": {
            "args": [
              "+test",
              "--INDEX=1",
              "--INDEX=2",
              "--INDEX=3",
              "--INDEX=4",
              "--INDEX=5"
            ],
            "name": "BUILD"
          }
        },
        {
          "command": {
            "args": [
              "+test-digest-pinned-image"
            ],
            "name": "BUILD"
          }
        },
        {
          "command": {
            "args": [
              "+test-digest-pinned-image-offline"
            ],
            "name": "BUILD"
          }
        }
      ]
    },
    {
      "name": "print-countries",
      "recipe": [
        {
          "command": {
            "args": [
              "jbergknoff/postgresql-client:latest"
            ],
            "name": "FROM"
          }
        },
        {
          "command": {
            "args": [
              "-c",
              "SELECT * FROM country WHERE country_id = '76'"
            ],
            "execMode": true,
            "name": "CMD"
          }
        },
        {
          "command": {
            "args": [
              "print-countries:latest"
            ],
            "name": "SAVE IMAGE"
          }
        }
      ]
    },
    {
      "name": "test",
      "recipe": [
        {
          "command": {
            "args": [
              "apk",
              "add",
              "--no-cache",
              "postgresql-client"
            ],
            "name": "RUN"
          }
        },
        {
          "command": {
            "args": [
              "docker-compose.yml",
              "."
            ],
            "name": "COPY"
          }
        },
        {
          "command": {
            "args": [
              "INDEX",
              "=",
              "0"
            ],
            "docs": "Index is used to create parallel tests.\n",
            "name": "ARG"
          }
        },
        {
          "with": {
            "body": [
              {
                "command": {
                  "args": [
                    "while",
                    "!",
                    "pg_isready",
                    "--host=localhost",
                    "--port=5432",
                    "--dbname=iso3166",
                    "--username=postgres;",
                    "do",
                    "sleep",
                    "1;",
                    "done",
                    ";docker-compose",
                    "up",
                    "--exit-code-from",
                    "print-countries",
                    "print-countries",
                    "|",
                    "grep",
                    "Brazil"
                  ],
                  "name": "RUN"
                }
              }
            ],
            "command": {
              "args": [
                "--compose",
                "docker-compose.yml",
                "--service",
                "postgres",
                "--load",
                "+print-countries"
              ],
              "name": "DOCKER"
            }
          }
        }
      ]
    },
    {
      "docs": "Regression test for https://github.com/EarthBuild/earthbuild/issues/512:\ncompose services pinned by digest must not break the image pre-pull, and the\npin must still be honoured when the service runs.\n",
      "name": "test-digest-pinned-image",
      "recipe": [
        {
          "command": {
            "args": [
              "docker-compose.digest.yml",
              "./docker-compose.yml"
            ],
            "name": "COPY"
          }
        },
        {
          "with": {
            "body": [
              {
                "command": {
                  "args": [
                    "docker",
                    "compose",
                    "run",
                    "--rm",
                    "tag-and-digest",
                    "|",
                    "grep",
                    "'hello from tag-and-digest'",
                    "&&",
                    "docker",
                    "compose",
                    "run",
                    "--rm",
                    "digest-only",
                    "|",
                    "grep",
                    "'hello from digest-only'",
                    "&&",
                    "docker",
                    "image",
                    "inspect",
                    "alpine@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6"
                  ],
                  "name": "RUN"
                }
              }
            ],
            "command": {
              "args": [
                "--compose",
                "docker-compose.yml"
              ],
              "name": "DOCKER"
            }
          }
        }
      ]
    },
    {
      "docs": "Digest-pinned Docker Hub images are served by the embedded registry, so they\nresolve without the network. The images are listed with --pull rather than\n--compose so that nothing is pulled before the RUN starts.\n",
      "name": "test-digest-pinned-image-offline",
      "recipe": [
        {
          "command": {
            "args": [
              "docker-compose.digest.yml",
              "./docker-compose.yml"
            ],
            "name": "COPY"
          }
        },
        {
          "command": {
            "args": [
              "mkdir",
              "-p",
              "/etc/docker",
              "&&",
              "echo",
              "'{\"proxies\": {\"http-proxy\": \"http://127.0.0.1:9\", \"https-proxy\": \"http://127.0.0.1:9\", \"no-proxy\": \"172.30.0.1\"}}'",
              ">/etc/docker/daemon.json"
            ],
            "docs": "Send all registry traffic of the WITH DOCKER daemon to a dead proxy, except\nfor the embedded registry (see dockerd-wrapper.sh, which merges this file\ninto its own daemon config). Unlike firewall rules, this cannot leak into\nother RUNs sharing the network namespace.\n",
            "name": "RUN"
          }
        },
        {
          "with": {
            "body": [
              {
                "command": {
                  "args": [
                    "docker",
                    "compose",
                    "run",
                    "--rm",
                    "tag-and-digest",
                    "|",
                    "grep",
                    "'hello from tag-and-digest'",
                    "&&",
                    "docker",
                    "compose",
                    "run",
                    "--rm",
                    "digest-only",
                    "|",
                    "grep",
                    "'hello from digest-only'",
                    "&&",
                    "docker",
                    "image",
                    "inspect",
                    "alpine@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6",
                    ">/dev/null",
                    "&&",
                    "!",
                    "docker",
                    "pull",
                    "busybox:1.37"
                  ],
                  "docs": "# The last pull is a control: an image the embedded registry does not\n# have must fail to pull, proving the daemon cannot reach the network.",
                  "name": "RUN"
                }
              }
            ],
            "command": {
              "args": [
                "--pull",
                "alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6",
                "--pull",
                "alpine@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6"
              ],
              "name": "DOCKER"
            }
          }
        }
      ]
    }
  ],
  "version": {
    "args": [
      "0.8"
    ]
  }
}
