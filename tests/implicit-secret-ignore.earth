VERSION 0.8
FROM alpine:3.24.2
WORKDIR /test

all:
    BUILD +copy
    BUILD +dockerfile

copy:
    COPY . .
    # .secret files must never be swept into a local build context, even though
    # VERSION 0.8 enables --no-implicit-ignore.
    RUN ls Earthfile
    RUN ls sub/notsecret
    RUN ! ls .secret
    RUN ! ls sub/.secret

dockerfile:
    FROM DOCKERFILE .
    WORKDIR /app
    RUN ls Dockerfile
    RUN ! ls .secret
    RUN ! ls sub/.secret
