VERSION 0.8

producer:
    FROM alpine:3.24.2
    RUN echo payload > /payload && chown 1000:1000 /payload
    SAVE ARTIFACT /payload

with-symlink:
    FROM alpine:3.24.2
    RUN adduser -D testuser && mkdir /real && ln -s /real /linked

default:
    FROM +with-symlink
    COPY +producer/payload /linked/payload
    RUN test ! -L /linked && test "$(stat -c '%u:%g' /linked/payload)" = '0:0' && test "$(cat /linked/payload)" = payload

preserved:
    FROM +with-symlink
    COPY --keep-own +producer/payload /linked/payload
    RUN test ! -L /linked && test "$(stat -c '%u:%g' /linked/payload)" = '1000:1000' && test "$(cat /linked/payload)" = payload

numeric:
    FROM +with-symlink
    COPY --chown=1234:5678 +producer/payload /linked/payload
    RUN test ! -L /linked && test "$(stat -c '%u:%g' /linked/payload)" = '1234:5678' && test "$(cat /linked/payload)" = payload

named:
    FROM +with-symlink
    COPY --chown=testuser:testuser +producer/payload /linked/payload
    RUN test -L /linked && test "$(stat -c '%u:%g' /linked/payload)" = '1000:1000' && test "$(cat /linked/payload)" = payload

test:
    BUILD +default
    BUILD +preserved
    BUILD +numeric
    BUILD +named
