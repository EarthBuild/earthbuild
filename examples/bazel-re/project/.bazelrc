# Bazel pointed at the engine running this step.
#
# `grpcs` because bazel, like buck2, speaks TLS to a remote executor; the
# certificate is made per step and lives beside the socket, on the ephemeral
# mount that disappears with the step.
build --remote_executor=grpcs://127.0.0.1:8980
build --tls_certificate=/run/earthbuild/ca.pem

# **Remote or nothing.** A fallback to local execution would let this report
# success while proving nothing, which is the one answer the experiment must
# not be able to give.
build --spawn_strategy=remote
build --genrule_strategy=remote

build --remote_timeout=300
build --verbose_failures
build --noshow_progress
