{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "earthfile",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "target"
          },
          {
            "type": "SYMBOL",
            "name": "function"
          },
          {
            "type": "SYMBOL",
            "name": "command"
          },
          {
            "type": "SYMBOL",
            "name": "comment"
          },
          {
            "type": "SYMBOL",
            "name": "blank_line"
          },
          {
            "type": "SYMBOL",
            "name": "unknown_line"
          }
        ]
      }
    },
    "target": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "target_name"
          }
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "trailing",
              "content": {
                "type": "SYMBOL",
                "name": "arguments"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "function": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "name",
              "content": {
                "type": "SYMBOL",
                "name": "function_name"
              }
            },
            {
              "type": "STRING",
              "value": ":"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "FIELD",
                  "name": "trailing",
                  "content": {
                    "type": "SYMBOL",
                    "name": "arguments"
                  }
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "SYMBOL",
              "name": "_line_end"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "name",
              "content": {
                "type": "SYMBOL",
                "name": "explicit_function_header"
              }
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "FIELD",
                  "name": "trailing",
                  "content": {
                    "type": "SYMBOL",
                    "name": "arguments"
                  }
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "SYMBOL",
              "name": "_line_end"
            }
          ]
        }
      ]
    },
    "explicit_function_header": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 40,
        "content": {
          "type": "PATTERN",
          "value": "(COMMAND|FUNCTION)[ \\t]+[A-Z][A-Z0-9._-]*:"
        }
      }
    },
    "command": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_indent"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "body",
          "content": {
            "type": "TOKEN",
            "content": {
              "type": "PREC",
              "value": 30,
              "content": {
                "type": "PATTERN",
                "value": "(?:FROM DOCKERFILE|SAVE ARTIFACT|SAVE IMAGE|GIT CLONE|ELSE IF|WITH DOCKER|ADD|ARG|BUILD|CACHE|CATCH|CMD|COMMAND|COPY|DO|ELSE|END|ENTRYPOINT|ENV|EXPOSE|FINALLY|FOR|FROM|FUNCTION|HEALTHCHECK|HOST|IF|IMPORT|LABEL|LET|LOCALLY|ONBUILD|PROJECT|RUN|SET|SHELL|STOPSIGNAL|TRY|USER|VERSION|VOLUME|WAIT|WITH|WORKDIR)(?:[ \\t][^\\r\\n]*)?\\r?\\n"
              }
            }
          }
        }
      ]
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_indent"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "PATTERN",
          "value": "#[^\\r\\n]*"
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "blank_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_indent"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "unknown_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_indent"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": -10,
            "content": {
              "type": "PATTERN",
              "value": "[^ \\t\\r\\n][^\\r\\n]*"
            }
          }
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "target_name": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 20,
        "content": {
          "type": "PATTERN",
          "value": "[a-z][a-zA-Z0-9.-]*"
        }
      }
    },
    "function_name": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 20,
        "content": {
          "type": "PATTERN",
          "value": "[A-Z][A-Z0-9._-]*"
        }
      }
    },
    "arguments": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\r\\n]+"
      }
    },
    "_indent": {
      "type": "PATTERN",
      "value": "[ \\t]+"
    },
    "_line_end": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_newline"
        },
        {
          "type": "SYMBOL",
          "name": "_eof"
        }
      ]
    },
    "_newline": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "\r\n"
        },
        {
          "type": "STRING",
          "value": "\n"
        },
        {
          "type": "STRING",
          "value": "\r"
        }
      ]
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_eof"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}