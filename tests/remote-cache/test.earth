VERSION 0.8
ARG --global REGISTRY

test1:
    FROM alpine:3.24.2
    RUN echo "execute-test1-run-before-copy"
    COPY ./input ./
    RUN echo "execute-test1-run-after-copy"
    SAVE IMAGE --push --insecure $REGISTRY/test1:latest

test2-base:
    FROM node:26.10.0-alpine3.24
    # renovate: datasource=npm packageName=npm
    ARG npm_version=11.6.1
    RUN npm install -g npm@$npm_version
    WORKDIR /js-example

test2-deps:
    FROM +test2-base
    COPY test2/package.json test2/package-lock.json ./
    RUN npm install
    SAVE ARTIFACT package-lock.json

test2-build:
    FROM +test2-deps
    COPY test2/src src
    COPY test2/dist dist
    RUN npx webpack
    SAVE ARTIFACT dist

test2:
    FROM +test2-deps
    COPY +test2-build/dist ./dist
    EXPOSE 8080
    ENTRYPOINT ["/js-example/node_modules/http-server/bin/http-server", "./dist"]
    SAVE IMAGE --push --insecure $REGISTRY/test2:latest

# test4-let, test4-if, test4-for and test4-wait-final each run steps below a
# local COPY after part of their state has been solved on its own.
test4-let:
    FROM alpine:3.24.2
    COPY ./input ./
    LET content="$(cat input)"
    RUN echo "execute-test4-let $content"

test4-if:
    FROM alpine:3.24.2
    COPY ./input ./
    IF [ -f input ]
        RUN echo "execute-test4-if-body"
    END
    RUN echo "execute-test4-if-after"

test4-for:
    FROM alpine:3.24.2
    COPY ./input ./
    FOR word IN $(cat input)
        RUN echo "execute-test4-for-body $word"
    END
    RUN echo "execute-test4-for-after"

test4-wait-base:
    FROM alpine:3.24.2
    COPY ./input ./
    RUN echo "execute-test4-wait-base"

test4-wait-top:
    FROM +test4-wait-base
    RUN echo "execute-test4-wait-top"

test4-wait-final:
    FROM +test4-wait-top
    COPY ./input-final ./
    RUN echo "execute-test4-wait-final"

test4:
    BUILD +test4-let
    BUILD +test4-if
    BUILD +test4-for
    WAIT
        BUILD +test4-wait-top
    END
    BUILD +test4-wait-final

# Smoke test for --cache-hint.
test3:
    FROM alpine:3.24.2
    RUN echo "content" >./file.txt
    SAVE IMAGE --cache-hint
