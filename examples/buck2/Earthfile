VERSION 0.8

# Buck2, running as a target, whose actions this engine executes.
#
# **The shape the remote-execution work is for.** Buck2 inside an `earth` target
# is supported; buck2 outside one is not. So nothing is installed on a machine:
# the target's FROM brings the client in, and `WITH RE` gives that step a socket
# in its own filesystem that answers the remote execution API for the
# environment the step is standing in.
#
# See docs-internals/plan-remote-execution.md, phase R5.

# renovate: datasource=github-releases packageName=facebook/buck2
ARG --global buck2_version=2025-05-06

client:
    FROM debian:bookworm-slim
    RUN apt-get update -qq \
     && apt-get install -y --no-install-recommends ca-certificates curl zstd \
     && rm -rf /var/lib/apt/lists/*
    # The released binary, so this target is about the protocol rather than
    # about building a build system.
    RUN curl -fsSL --retry 5 --retry-all-errors \
          "https://github.com/facebook/buck2/releases/download/$buck2_version/buck2-x86_64-unknown-linux-gnu.zst" \
        | zstd -d > /usr/local/bin/buck2 \
     && chmod +x /usr/local/bin/buck2 \
     && buck2 --version

# build runs the project's one action through this engine.
#
# `WITH RE` is the whole of the opt-in. Without it there is no socket, buck2
# cannot reach a service, and - because the execution platform is remote-only -
# it fails rather than quietly building locally and reporting success.
build:
    FROM +client
    WORKDIR /w
    COPY project .
    WITH RE
        RUN buck2 build //:hello --show-output
    END

# reach asks only whether the socket is there, for when `build` fails and the
# question is which half.
reach:
    FROM +client
    WITH RE
        RUN test -S /run/earthbuild/actions.sock && echo "the socket is there"
    END
