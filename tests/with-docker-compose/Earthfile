VERSION 0.8

ARG DIND_IMAGE=earthbuild/dind:alpine-3.24-docker-29.8.2-r0
FROM $DIND_IMAGE
WORKDIR /test

all:
    BUILD +test \
        --INDEX=1 \
        --INDEX=2 \
        --INDEX=3 \
        --INDEX=4 \
        --INDEX=5
    BUILD +test-digest-pinned-image

print-countries:
    FROM jbergknoff/postgresql-client:latest
    CMD ["-c", "SELECT * FROM country WHERE country_id = '76'"]
    SAVE IMAGE print-countries:latest

test:
    RUN apk add --no-cache postgresql-client
    COPY docker-compose.yml .
    # Index is used to create parallel tests.
    ARG INDEX=0
    WITH DOCKER \
            --compose docker-compose.yml \
            --service postgres \
            --load +print-countries
        RUN while ! pg_isready --host=localhost --port=5432 --dbname=iso3166 --username=postgres; do sleep 1; done ;\
            docker-compose up --exit-code-from print-countries print-countries | grep Brazil
    END

# Regression test for https://github.com/EarthBuild/earthbuild/issues/512:
# compose services pinned by digest must not break the image pre-pull, and the
# pin must still be honoured when the service runs.
test-digest-pinned-image:
    COPY docker-compose.digest.yml ./docker-compose.yml
    WITH DOCKER --compose docker-compose.yml
        RUN docker compose run --rm tag-and-digest | grep 'hello from tag-and-digest' && \
            docker compose run --rm digest-only | grep 'hello from digest-only' && \
            docker image inspect alpine@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
    END
